# ==============================================================================
# SHUGO Log Analysis Agent - Environment Variables Template
# Copy this file to .env and configure values before starting the agent.
# ==============================================================================

# PostgreSQL Connection String (SQLAlchemy + psycopg2)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shugo_cyber

# Google Gemini Gen AI SDK Credentials
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Model Identifier
# Sensible default: gemini-2.5-flash.
# NOTE: Check current available models at https://ai.google.dev/gemini-api/docs/models/gemini
GEMINI_MODEL=gemini-2.5-flash

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
